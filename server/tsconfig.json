{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@config/*": ["config/*"],
      "@health/*": ["src/modules/health/*"],
      "@common/*": ["src/common/*"],
      "@guards/*": ["src/common/guards/*"],
      "@interceptors/*": ["src/common/interceptors/*"],
      "@middlewares/*": ["src/common/middlewares/*"],
      "@app/*": ["src/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@users/*": ["src/modules/users/*"],
      "@budgets/*": ["src/modules/budgets/*"],
      "@categories/*": ["src/modules/categories/*"],
      "@expenses/*": ["src/modules/expenses/*"],
      "@incomes/*": ["src/modules/incomes/*"],
      "@reports/*": ["src/modules/reports/*"],
      "@shared/*": ["src/modules/shared/*"],
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
