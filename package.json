{
  "name": "presupco-root",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "api:docs:update": "chmod +x ./scripts/postman/update-collection.sh && ./scripts/postman/update-collection.sh"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "axios": "^1.6.0",
    "openapi-to-postmanv2": "^3.0.0"
  },
  "lint-staged": {
    "server/**/*.{ts,js}": [
      "yarn --cwd server lint --max-warnings 0",
      "git add server"
    ],
    "webapp/**/*.{ts,js,html,scss,css}": [
      "yarn --cwd webapp lint --max-warnings 0",
      "git add webapp"
    ]
  }
}
